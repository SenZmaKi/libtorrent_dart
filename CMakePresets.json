{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/cmake_build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "LTD_BOOST_HEADERS_ROOT": "/usr/include"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 – GCC/Clang Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "LTD_TARGET_ARCHITECTURE": "x64"
      }
    },
    {
      "name": "linux-arm64",
      "displayName": "Linux arm64 – GCC/Clang Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "LTD_TARGET_ARCHITECTURE": "arm64"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "LTD_BOOST_HEADERS_ROOT": "/opt/homebrew/include"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64 – Clang Release",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    },
    {
      "name": "macos-x64",
      "displayName": "macOS x64 – Clang Release",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "10.15",
        "LTD_BOOST_HEADERS_ROOT": "/usr/local/include"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 – MSVC Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "LTD_TARGET_ARCHITECTURE": "x64"
      }
    },
    {
      "name": "windows-arm64",
      "displayName": "Windows arm64 – MSVC Release",
      "inherits": "windows-base",
      "cacheVariables": {
        "LTD_TARGET_ARCHITECTURE": "arm64"
      }
    },
    {
      "name": "android-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_static",
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
        "HAVE_CXX_ATOMICS_WITHOUT_LIB": "ON",
        "HAVE_CXX_ATOMICS8_WITHOUT_LIB": "ON",
        "HAVE_CXX_ATOMICS64_WITHOUT_LIB": "ON"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a Release",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "LTD_TARGET_ARCHITECTURE": "arm64-v8a"
      }
    },
    {
      "name": "android-x64",
      "displayName": "Android x86_64 Release",
      "inherits": "android-base",
      "cacheVariables": {
        "ANDROID_ABI": "x86_64",
        "LTD_TARGET_ARCHITECTURE": "x86_64"
      }
    },
    {
      "name": "ios",
      "displayName": "iOS arm64 Release",
      "inherits": "base",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_DISABLE_FIND_PACKAGE_OpenSSL": "ON",
        "LTD_BOOST_HEADERS_ROOT": "/opt/homebrew/include"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64",
      "targets": ["libtorrent_dart"]
    },
    {
      "name": "linux-arm64",
      "configurePreset": "linux-arm64",
      "targets": ["libtorrent_dart"]
    },
    {
      "name": "macos-arm64",
      "configurePreset": "macos-arm64",
      "targets": ["libtorrent_dart"]
    },
    {
      "name": "macos-x64",
      "configurePreset": "macos-x64",
      "targets": ["libtorrent_dart"]
    },
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "targets": ["libtorrent_dart"]
    },
    {
      "name": "windows-arm64",
      "configurePreset": "windows-arm64",
      "targets": ["libtorrent_dart"]
    },
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64",
      "targets": ["libtorrent_dart"]
    },
    {
      "name": "android-x64",
      "configurePreset": "android-x64",
      "targets": ["libtorrent_dart"]
    },
    {
      "name": "ios",
      "configurePreset": "ios",
      "targets": ["libtorrent_dart_ios_bundle"],
      "configuration": "Release"
    }
  ]
}
